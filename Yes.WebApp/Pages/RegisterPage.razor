@page "/register"
@layout AuthenticationLayout

<PageTitle>Register</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small">
    <MudPaper>
        <MudStack Spacing="4" Class="pa-4">
            <MudText Typo="Typo.h3" Align="Align.Center">Register</MudText>

            <MudTextField Label="Username" @bind-Value="_request.Username" Variant="Variant.Filled" />
            <MudTextField Label="Email" @bind-Value="_request.Email" InputType="InputType.Email" Variant="Variant.Filled" />
            <MudTextField Label="Password" @bind-Value="_request.Password" InputType="InputType.Password" Variant="Variant.Filled" />
            <MudButton OnClick="EnterAsync" Color="Color.Primary" Size="Size.Large" Variant="Variant.Filled">Enter</MudButton>

            <MudText Align="Align.Center" Typo="Typo.subtitle2">Do you have an account? <MudLink Href="/login">Login</MudLink></MudText>
        </MudStack>
    </MudPaper>
</MudContainer>