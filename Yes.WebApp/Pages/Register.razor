@page "/register"
@layout AuthenticationLayout

<MudContainer MaxWidth="MaxWidth.Medium">
    <MudPaper>
        <MudStack Spacing="4" Class="pa-4">
            <MudText Typo="Typo.h3" Align="Align.Center">Register</MudText>

            <MudForm Class="gap-2">
                <MudTextField Label="Username" @bind-Value="_username" Variant="Variant.Filled" />
                <MudTextField Label="Email" @bind-Value="_email" Variant="Variant.Filled" />
                <MudTextField Label="Password" @bind-Value="_password" InputType="InputType.Password" Variant="Variant.Filled" />
                <MudButton OnClick="SubmitAsync" ButtonType="ButtonType.Button" Color="Color.Primary" Size="Size.Large" 
                    Variant="Variant.Filled">Submit</MudButton>
            </MudForm>
        </MudStack>
    </MudPaper>
</MudContainer>