@page "/users/details"
@layout MainLayout

<MudStack Spacing="4">
    <MudText Align="Align.Center" Typo="Typo.h4">@userContext.Username</MudText>
    <MudText Align="Align.Center" Typo="Typo.body2">@userContext.Email</MudText>
    <MudStack Row="true">
        <MudButton Color="Color.Primary" Variant="Variant.Filled">Update</MudButton>
        <MudButton Color="Color.Error" Variant="Variant.Filled">Delete</MudButton>
    </MudStack>
</MudStack>